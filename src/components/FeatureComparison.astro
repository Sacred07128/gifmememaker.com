---
const features = [
  {
    title: 'AI Meme Captions',
    eyebrow: 'NEURAL ENGINE',
    body: 'Generate top & bottom captions in seconds. Five comedic vibes — humorous, relatable, tech, sarcastic and Gen Z — each tuned for instant shareability.',
    icon: '🤖'
  },
  {
    title: 'Animated GIF Studio',
    eyebrow: 'REAL-TIME CANVAS',
    body: 'Load animated GIF templates and keep them moving while you add text. Convert any video clip to a crisp looping GIF, all on your machine.',
    icon: '🎞️'
  },
  {
    title: 'Trim, Speed & Scrub',
    eyebrow: 'PRECISION TIMELINE',
    body: 'Frame-accurate trimming, a scrubber timeline and 0.25x to 3.0x speed control. Hit space to play or pause. Rotate and flip with one tap.',
    icon: '⚡'
  },
  {
    title: '100% Private by Design',
    eyebrow: 'CLIENT-SIDE ONLY',
    body: 'Your files never leave the browser. Decoding, canvas rendering, frame extraction and encoding all happen locally — no uploads, no servers, no tracking.',
    icon: '🔒'
  },
  {
    title: '70+ Curated Templates',
    eyebrow: 'TEMPLATE VAULT',
    body: 'Still-image classics and trending reaction GIFs, organized by category with live search. Filter to completely free templates with a single click.',
    icon: '📚'
  },
  {
    title: 'Pro-Grade Exports',
    eyebrow: 'EVERY FORMAT',
    body: 'Export GIF, PNG or JPG stills at up to 1080p for free — unlock 4K stills, 30/60 FPS GIFs and WEBM/MP4 video with Pro.',
    icon: '📤'
  },
  {
    title: 'Custom Watermarks',
    eyebrow: 'YOUR BRAND',
    body: 'Add custom watermark text, position and opacity on every export. Remove entirely with Pro for clean, professional output.',
    icon: '🏷️'
  },
  {
    title: 'Free-Features-Only Mode',
    eyebrow: 'SIMPLE SWITCH',
    body: 'Toggle free-only mode to hide Pro features and filter the gallery to 100% free templates. No upsells, no dark patterns.',
    icon: '🎯'
  }
];
---

<section id="comparison" class="py-16 sm:py-24 bg-[#fafafa] dark:bg-[#0a0a0a] border-b border-[#ebebeb] dark:border-[#222222] transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <div class="font-mono-eyebrow text-[#0070f3] dark:text-[#3291ff] mb-3">WHY GIFMEMEMAKER</div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#171717] dark:text-white tracking-[-0.03em]">
        Built to be the meme studio you actually enjoy
      </h2>
      <p class="text-sm text-[#4d4d4d] dark:text-[#a1a1a1] mt-3">
        A real-time canvas engine, a clear free tier, and a Pro plan that earns its keep — not the other way around.
      </p>
    </div>

    <!-- Feature Card Grid (hairline cards, 12px radius, 24px padding) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {features.map((f) => (
        <div class="bg-white dark:bg-[#111111] border border-[#ebebeb] dark:border-[#222222] rounded-xl p-6 shadow-[0px_1px_1px_rgba(0,0,0,0.04)]">
          <div class="text-3xl mb-3">{f.icon}</div>
          <div class="font-mono-eyebrow text-[#8f8f8f] dark:text-[#666666] mb-3">{f.eyebrow}</div>
          <h3 class="text-base font-semibold text-[#171717] dark:text-white mb-2 tracking-tight">{f.title}</h3>
          <p class="text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">{f.body}</p>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-16">
      <a href="#studio" class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] font-semibold text-base hover:opacity-90 transition-all shadow-md hover:shadow-xl">
        <span>Launch Meme Studio</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>