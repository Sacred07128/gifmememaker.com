---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Canonical path, e.g. "/privacy-policy/" */
  path: string;
  h1: string;
  eyebrow: string;
  /** Optional "last updated" stamp shown under the intro. */
  updated?: string;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  path,
  h1,
  eyebrow,
  updated,
  jsonLd = [],
} = Astro.props;
---

<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <Header />
  <main>
    <!-- Page hero -->
    <section
      class="border-b border-[#ebebeb] dark:border-[#222222] geist-mesh-gradient"
    >
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
        <span class="font-mono-eyebrow text-[#0070f3] dark:text-[#3291ff]">
          {eyebrow}
        </span>
        <h1
          class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[#171717] dark:text-white"
        >
          {h1}
        </h1>
        <p
          class="mt-4 text-base sm:text-lg text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed max-w-2xl"
        >
          {description}
        </p>
        {
          updated && (
            <p class="mt-4 font-mono text-xs text-[#8f8f8f] dark:text-[#666666]">
              Last updated: {updated}
            </p>
          )
        }
      </div>
    </section>

    <!-- Article body -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 page-prose">
      <slot />
    </section>
  </main>
  <Footer />
</Layout>
