---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';

const TITLE = 'Page Not Found (404) | gifmememaker.com';
const DESCRIPTION =
  'The page you requested does not exist. Return to the free meme maker online and keep creating memes, GIF memes and video memes.';

const LINKS = [
  {
    href: '/#studio',
    eyebrow: 'Studio',
    title: 'Open the Meme Maker',
    text: 'Upload an image, GIF or video — or start from a template — in the free meme maker app.',
  },
  {
    href: '/#templates',
    eyebrow: 'Templates',
    title: 'Browse the Template Vault',
    text: '180+ ready-made meme templates: classic formats, anime, dev memes and reaction GIFs.',
  },
  {
    href: '/#comparison',
    eyebrow: 'Pricing',
    title: 'Free vs Premium Tiers',
    text: 'Compare features: watermark-free, 4K export, video memes, unlimited caption generations.',
  },
  {
    href: '/#faq',
    eyebrow: 'FAQ',
    title: 'Frequently Asked Questions',
    text: 'Answers about video memes, GIF export, privacy and the free vs Pro tiers.',
  },
  {
    href: '/about-us/',
    eyebrow: 'About',
    title: 'About gifmememaker.com',
    text: 'Who builds this online meme maker and why everything runs privately in your browser.',
  },
  {
    href: '/contact-us/',
    eyebrow: 'Contact',
    title: 'Contact Us',
    text: 'Found a bug or have a feature request? The meme maker support team wants to hear it.',
  },
];
---

<Layout title={TITLE} description={DESCRIPTION} path="/404" noindex>
  <Header />
  <main>
    <!-- 404 hero -->
    <section class="border-b border-[#ebebeb] dark:border-[#222222] geist-mesh-gradient">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 text-center">
        <Logo class="w-24 h-24 mx-auto rounded-2xl shadow-lg" />
        <span class="block mt-8 font-mono-eyebrow text-[#0070f3] dark:text-[#3291ff]">
          Error 404 — Page Not Found
        </span>
        <h1
          class="mt-3 text-5xl sm:text-6xl font-extrabold tracking-tight text-[#171717] dark:text-white"
        >
          This page ghosted us
        </h1>
        <p
          class="mt-4 text-base sm:text-lg text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed max-w-xl mx-auto"
        >
          The page you are looking for does not exist — it may have been moved, deleted, or the link was
          mistyped. The memes, however, are exactly where you left them.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/"
            class="px-5 py-2.5 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] text-sm font-medium hover:opacity-90 transition-all shadow-sm active:scale-95"
          >
            Back to the Meme Maker
          </a>
          <a
            href="/#templates"
            class="px-5 py-2.5 rounded-full border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#111111] text-[#171717] dark:text-white text-sm font-medium hover:bg-[#fafafa] dark:hover:bg-[#1a1a1a] transition-colors"
          >
            Browse Templates
          </a>
        </div>
      </div>
    </section>

    <!-- Quick links -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <h2 class="font-mono-eyebrow text-[#8f8f8f] dark:text-[#666666] mb-6 text-center sm:text-left">
        Or jump straight to
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          LINKS.map((link) => (
            <a
              href={link.href}
              class="block rounded-xl border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#111111] p-5 hover:border-[#0070f3] hover:shadow-sm transition-all group"
            >
              <span class="font-mono-eyebrow text-[#0070f3] dark:text-[#3291ff]">{link.eyebrow}</span>
              <span class="block mt-1.5 font-semibold text-[#171717] dark:text-white group-hover:text-[#0070f3] dark:group-hover:text-[#3291ff] transition-colors">
                {link.title}
              </span>
              <span class="block mt-1 text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
                {link.text}
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>