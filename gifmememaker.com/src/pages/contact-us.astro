---
import ContentPage from '../components/ContentPage.astro';
import { SITE_URL } from '../data/site';

const TITLE = 'Contact Us | gifmememaker.com Meme Maker Support';
const DESCRIPTION =
  'Questions, bug reports or feature requests for the meme maker? Contact the gifmememaker.com team — we reply within 1–2 business days.';
const PATH = '/contact-us/';
const EMAIL = 'support@gifmememaker.com';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Contact Us', item: `${SITE_URL}${PATH}` },
  ],
};

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Us — gifmememaker.com',
  url: `${SITE_URL}${PATH}`,
  description: DESCRIPTION,
  inLanguage: 'en',
  mainEntity: {
    '@type': 'Organization',
    name: 'gifmememaker.com',
    url: `${SITE_URL}/`,
    email: `mailto:${EMAIL}`,
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: `mailto:${EMAIL}`,
      availableLanguage: ['English'],
    },
  },
};
---

<ContentPage
  title={TITLE}
  description={DESCRIPTION}
  path={PATH}
  eyebrow="Contact"
  h1="Contact Us"
  jsonLd={[breadcrumb, contactSchema]}
>
  <h2>Email Us</h2>
  <p>
    The fastest way to reach the gifmememaker.com team is email:
    <strong><a href={`mailto:${EMAIL}`}>{EMAIL}</a></strong>. We read everything — support questions,
    bug reports, template ideas and wild feature requests alike. We aim to reply within
    <strong>1–2 business days</strong>.
  </p>

  <h2>What to Include in a Bug Report</h2>
  <p>
    If something in the meme maker misbehaves, a good bug report gets you a fix much faster. Please include:
  </p>
  <ol>
    <li>What you were doing (e.g. "exporting a trimmed GIF with captions").</li>
    <li>What you expected to happen vs. what actually happened.</li>
    <li>Your browser and version (Chrome, Firefox, Safari, Edge) and operating system.</li>
    <li>The template or file type involved — image, GIF, MP4/WebM/MOV — without sending us private media.</li>
  </ol>

  <h2>Feature Requests & Template Submissions</h2>
  <p>
    Want a new meme template, a font, or an export option? Tell us what would make the
    <strong>free meme maker</strong> better for you. Template submissions are welcome — describe the meme
    concept and, if it is an existing popular format, link to where it is commonly shared. We review
    requests weekly and prioritize what our creators ask for most.
  </p>

  <h2>Business & Partnership Inquiries</h2>
  <p>
    For partnerships, licensing, press or advertising inquiries, email the same address with the subject
    line "Business" so it lands in the right inbox. Please include your name, organization and a short
    description of what you have in mind.
  </p>

  <h2>Quick Answers</h2>
  <p>
    Before you write, check the <a href="/#faq">FAQ section</a> — it covers pricing, privacy, the instant
    caption generator, video and GIF export, and watermark questions. Learn more about the project on the
    <a href="/about-us/">About Us page</a>, or read how we handle data in the
    <a href="/privacy-policy/">Privacy Policy</a>.
  </p>
</ContentPage>