<script>
  import { MemeStudio } from '../scripts/studio';

  const studio = new MemeStudio();
  studio.init();

  // Caption generation
  document.querySelectorAll('.ai-gen-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-ai-category') || 'humorous';
      studio.generateAiCaption(cat);
    });
  });

  // Pro modal backdrop click
  const backdrop = document.querySelector('[data-pro-backdrop]');
  backdrop?.addEventListener('click', () => {
    const modal = document.getElementById('pro-modal');
    if (modal) { modal.classList.add('hidden'); modal.classList.remove('flex'); }
  });

  // Tab switching
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabPanels = document.querySelectorAll('.tab-panel');
  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetTab = btn.getAttribute('data-tab');
      tabBtns.forEach((b) => {
        b.classList.remove('active-tab', 'text-[#171717]', 'dark:text-white', 'bg-[#fafafa]', 'dark:bg-[#1a1a1a]', 'border');
        b.classList.add('text-[#4d4d4d]', 'dark:text-[#a1a1a1]');
      });
      btn.classList.add('active-tab', 'text-[#171717]', 'dark:text-white', 'bg-[#fafafa]', 'dark:bg-[#1a1a1a]', 'border');
      tabPanels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.id !== targetTab);
      });
    });
  });
</script>
