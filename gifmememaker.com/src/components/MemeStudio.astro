---
---

<section id="studio" class="py-12 sm:py-16 bg-[#fafafa] dark:bg-[#0a0a0a] transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header (Geist Spec) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-6 border-b border-[#ebebeb] dark:border-[#222222] gap-4">
      <div>
        <div class="font-mono-eyebrow text-[#0070f3] dark:text-[#3291ff] mb-2 flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
          </svg>
          gifmememaker.com Interactive Studio
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-[#171717] dark:text-white tracking-[-0.03em] flex items-center gap-2">
          <span>Meme &amp; GIF Generator Studio</span>
        </h2>
      </div>

      <!-- Free vs All Features Toggle & Canvas Aspect Ratio Selector -->
      <div class="flex flex-wrap items-center gap-3">
        <!-- Filter Toggle: Free Features Only -->
        <label class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white dark:bg-[#111111] border border-[#ebebeb] dark:border-[#222222] text-xs font-semibold cursor-pointer shadow-xs">
          <input type="checkbox" id="chk-free-only-mode" class="rounded accent-[#0070f3] w-3.5 h-3.5" />
          <span class="text-[#0070f3] dark:text-[#3291ff]">Free Features Only</span>
        </label>

        <div class="flex items-center gap-1 bg-white dark:bg-[#111111] px-2.5 py-1.5 rounded-md border border-[#ebebeb] dark:border-[#222222]">
          <span class="text-xs font-mono text-[#8f8f8f]" id="canvas-dim-indicator">600 x 600px</span>
        </div>
        
        <div class="inline-flex rounded-md p-1 bg-white dark:bg-[#111111] border border-[#ebebeb] dark:border-[#222222] shadow-xs">
          <button data-aspect="auto" class="aspect-btn active-ratio px-2.5 py-1 text-xs font-medium rounded-sm text-[#171717] dark:text-white bg-[#fafafa] dark:bg-[#1a1a1a] shadow-xs">Auto</button>
          <button data-aspect="1:1" class="aspect-btn px-2.5 py-1 text-xs font-medium rounded-sm text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white transition-colors">1:1</button>
          <button data-aspect="16:9" class="aspect-btn px-2.5 py-1 text-xs font-medium rounded-sm text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white transition-colors">16:9</button>
          <button data-aspect="9:16" class="aspect-btn px-2.5 py-1 text-xs font-medium rounded-sm text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white transition-colors">9:16</button>
        </div>
      </div>
    </div>

    <!-- Main Studio Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Studio Left Column: Canvas Preview Area (7 cols) -->
      <div class="lg:col-span-7 flex flex-col items-center">
        <!-- Canvas Container Card (Geist Spec) -->
        <div class="w-full bg-white dark:bg-[#111111] border border-[#ebebeb] dark:border-[#222222] rounded-xl p-4 sm:p-6 shadow-sm flex flex-col items-center relative overflow-hidden group">
          
          <!-- Live Canvas Wrapper -->
          <div id="canvas-container" class="w-full max-w-lg aspect-square bg-[#0a0a0a] rounded-lg border border-[#222222] flex items-center justify-center relative overflow-hidden shadow-inner group">
            
            <!-- Hidden native video/image elements for engine processing -->
            <video id="source-video" class="hidden" playsinline loop crossorigin="anonymous" muted></video>
            <img id="source-image" class="hidden" crossorigin="anonymous" src="/assets/memes/blackbeard writing meme.png" />

            <!-- Main Render Canvas -->
            <canvas id="meme-canvas" class="max-w-full max-h-[460px] object-contain cursor-move rounded"></canvas>

            <!-- Initial Upload Overlay Dropzone -->
            <div id="upload-overlay" class="absolute inset-0 bg-[#0a0a0a]/90 backdrop-blur-xs flex flex-col items-center justify-center p-6 text-center cursor-pointer transition-opacity z-20">
              <input type="file" id="file-input" accept="image/*,.gif" class="hidden" />
              <input type="file" id="video-file-input" accept="video/*,.mp4,.webm,.mov,.mkv" class="hidden" />
              <div class="w-14 h-14 rounded-full bg-[#171717] border border-[#333333] flex items-center justify-center text-white mb-4 group-hover:scale-110 transition-transform">
                <svg class="w-7 h-7 text-[#0070f3]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                </svg>
              </div>
              <h3 class="text-base font-semibold text-white mb-1">Create Meme from Image, GIF or Video</h3>
              <p class="text-xs text-[#a1a1a1] max-w-sm mb-4">Free stills and animated GIFs, or unlock Pro mode to customize and caption videos &amp; clips</p>
              <div class="flex flex-wrap items-center justify-center gap-2.5">
                <span id="btn-browse-free" class="px-4 py-2 rounded-full bg-[#0070f3] text-white text-xs font-semibold hover:bg-[#0761d1] transition-all shadow-sm">Upload Image / GIF</span>
                <button type="button" id="btn-video-pro-upload" class="px-4 py-2 rounded-full bg-gradient-to-r from-[#7928ca] to-[#0070f3] text-white text-xs font-semibold hover:opacity-95 transition-all shadow-md flex items-center gap-1.5 active:scale-95">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                  <span>Caption Custom Video / Clip</span>
                  <span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-white text-[#7928ca]">PRO</span>
                </button>
                <button type="button" id="sample-demo-btn" class="px-3.5 py-2 rounded-full bg-[#222222] text-white border border-[#333333] text-xs font-medium hover:bg-[#333333] transition-all">Load Sample</button>
              </div>
            </div>

            <!-- Canvas Toast & Encoding Progress Modal -->
            <div id="studio-toast" class="absolute top-4 left-1/2 -translate-x-1/2 px-3.5 py-1.5 rounded-full bg-[#171717]/90 text-white text-xs font-medium backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300 border border-[#333333] z-30">
              Canvas Ready
            </div>

            <div id="export-progress-bar" class="absolute inset-0 bg-[#0a0a0a]/95 backdrop-blur-md flex flex-col items-center justify-center p-6 text-center opacity-0 pointer-events-none transition-opacity duration-200 z-40">
              <div class="w-12 h-12 rounded-full border-2 border-[#0070f3] border-t-transparent animate-spin mb-4"></div>
              <h4 class="text-base font-bold text-white mb-1">Encoding GIF File...</h4>
              <p id="progress-percent" class="font-mono text-sm text-[#0070f3] font-semibold mb-3">0%</p>
              <div class="w-48 h-1.5 bg-[#222222] rounded-full overflow-hidden">
                <div id="progress-fill" class="h-full bg-[#0070f3] w-0 transition-all duration-150"></div>
              </div>
            </div>
          </div>

          <!-- Video / GIF Timeline Controls -->
          <div class="w-full mt-4 pt-4 border-t border-[#ebebeb] dark:border-[#222222] flex flex-col gap-3">
            <div class="flex items-center justify-between gap-3">
              <!-- Play / Pause Button -->
              <button id="btn-play-pause" class="w-9 h-9 rounded-[6px] bg-[#171717] dark:bg-white text-white dark:text-[#171717] flex items-center justify-center hover:opacity-90 transition-all shrink-0">
                <svg id="icon-play" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                <svg id="icon-pause" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
              </button>

              <!-- Timeline Scrubber -->
              <div class="flex-1 flex items-center gap-2">
                <span id="current-time" class="font-mono text-xs text-[#8f8f8f]">00:00</span>
                <input type="range" id="timeline-scrubber" min="0" max="100" value="0" step="0.1" class="w-full h-1.5 bg-[#ebebeb] dark:bg-[#222222] rounded-lg appearance-none cursor-pointer accent-[#0070f3]" />
                <span id="duration-time" class="font-mono text-xs text-[#8f8f8f]">00:03</span>
              </div>

              <!-- Rotate / Flip / Reset Buttons & Video Pro Action -->
              <div class="flex items-center gap-1">
                <button id="btn-caption-video-tool" title="Caption Custom Video & Clip (Pro)" class="px-2 py-1 rounded-[6px] text-[10px] font-semibold text-[#7928ca] dark:text-[#d8ccf1] bg-[#7928ca]/10 border border-[#7928ca]/30 hover:bg-[#7928ca]/20 transition-all flex items-center gap-1">
                  <span>🎬 Video Clip</span>
                  <span class="text-[8px] font-bold px-1 rounded bg-[#7928ca] text-white">PRO</span>
                </button>
                <button id="btn-rotate-90" title="Rotate 90°" class="p-2 rounded-[6px] text-[#8f8f8f] hover:text-[#171717] dark:hover:text-white hover:bg-[#ebebeb]/50 dark:hover:bg-[#1a1a1a] transition-all">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                </button>
                <button id="btn-flip-h" title="Flip Horizontal" class="px-2 py-1.5 rounded-[6px] text-[10px] font-mono text-[#8f8f8f] hover:text-[#171717] dark:hover:text-white hover:bg-[#ebebeb]/50 dark:hover:bg-[#1a1a1a] transition-all">H</button>
                <button id="btn-flip-v" title="Flip Vertical" class="px-2 py-1.5 rounded-[6px] text-[10px] font-mono text-[#8f8f8f] hover:text-[#171717] dark:hover:text-white hover:bg-[#ebebeb]/50 dark:hover:bg-[#1a1a1a] transition-all">V</button>
                <button id="btn-reset-canvas" title="Reset All" class="px-2 py-1.5 rounded-[6px] text-[10px] font-mono text-[#8f8f8f] hover:text-[#171717] dark:hover:text-white hover:bg-[#ebebeb]/50 dark:hover:bg-[#1a1a1a] transition-all">RESET</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Keyboard Shortcuts Bar -->
        <div class="w-full mt-3 flex items-center justify-between text-[11px] text-[#8f8f8f] dark:text-[#666666] px-2 font-mono">
          <span>Drag text boxes to move · Double-click a text box to edit</span>
          <span>Space: Play/Pause · Drag & drop files anywhere on this section</span>
        </div>
      </div>

      <!-- Studio Right Column: Inspector & Controls (5 cols) -->
      <div class="lg:col-span-5 w-full bg-white dark:bg-[#111111] border border-[#ebebeb] dark:border-[#222222] rounded-xl p-4 sm:p-5 shadow-sm">
        
        <!-- Inspector Tabs Header -->
        <div class="flex items-center gap-1 border-b border-[#ebebeb] dark:border-[#222222] pb-3 mb-5 overflow-x-auto scrollbar-none">
          <button data-tab="tab-text" class="tab-btn active-tab px-2.5 py-1.5 rounded-[6px] text-xs font-semibold text-[#171717] dark:text-white bg-[#fafafa] dark:bg-[#1a1a1a] border border-[#ebebeb] dark:border-[#333333] transition-all shrink-0">
            Text & Meme
          </button>
          <button data-tab="tab-ai" class="tab-btn px-2.5 py-1.5 rounded-[6px] text-xs font-semibold text-[#7928ca] dark:text-[#d8ccf1] transition-all shrink-0 flex items-center gap-1">
            <span>💡 Caption Ideas</span>
          </button>
          <button data-tab="tab-trim" class="tab-btn px-2.5 py-1.5 rounded-[6px] text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white transition-all shrink-0">
            Trim & Speed
          </button>
          <button data-tab="tab-watermark-bg" class="tab-btn px-2.5 py-1.5 rounded-[6px] text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white transition-all shrink-0">
            Watermark & BG
          </button>
          <button data-tab="tab-export" class="tab-btn px-2.5 py-1.5 rounded-[6px] text-xs font-semibold text-[#0070f3] dark:text-[#3291ff] hover:opacity-90 transition-all shrink-0">
            Export
          </button>
        </div>

        <!-- TAB CONTENT 1: TEXT & MEMES -->
        <div id="tab-text" class="tab-panel flex flex-col gap-4">
          <!-- Top Meme Text -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="font-mono-eyebrow text-[11px] text-[#4d4d4d] dark:text-[#a1a1a1]">Top Text</label>
              <span class="text-[10px] text-[#0070f3] font-mono">⚡ FREE</span>
            </div>
            <input type="text" id="input-top-text" placeholder="ME WRITING CODE..." value="ME WRITING CODE..." class="w-full px-3 py-2 text-sm rounded-[6px] bg-[#fafafa] dark:bg-[#181818] border border-[#ebebeb] dark:border-[#333333] text-[#171717] dark:text-white focus:outline-none focus:border-[#0070f3] transition-colors" />
          </div>

          <!-- Bottom Meme Text -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="font-mono-eyebrow text-[11px] text-[#4d4d4d] dark:text-[#a1a1a1]">Bottom Text</label>
              <span class="text-[10px] text-[#0070f3] font-mono">⚡ FREE</span>
            </div>
            <input type="text" id="input-bottom-text" placeholder="VS ME WRITING DOCUMENTATION" value="VS ME WRITING DOCUMENTATION" class="w-full px-3 py-2 text-sm rounded-[6px] bg-[#fafafa] dark:bg-[#181818] border border-[#ebebeb] dark:border-[#333333] text-[#171717] dark:text-white focus:outline-none focus:border-[#0070f3] transition-colors" />
          </div>

          <!-- Font Style & Size Grid -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-mono-eyebrow text-[11px] text-[#4d4d4d] dark:text-[#a1a1a1] mb-1.5">Font Style</label>
              <select id="select-font-family" class="w-full px-3 py-2 text-xs rounded-[6px] bg-[#fafafa] dark:bg-[#181818] border border-[#ebebeb] dark:border-[#333333] text-[#171717] dark:text-white focus:outline-none focus:border-[#0070f3]">
                <option value="Impact">Classic Impact</option>
                <option value="Geist">Geist Sans</option>
                <option value="Anton">Anton Bold</option>
                <option value="Oswald">Oswald Meme</option>
                <option value="Comic Neue">Comic Neue</option>
              </select>
            </div>

            <div>
              <label class="block font-mono-eyebrow text-[11px] text-[#4d4d4d] dark:text-[#a1a1a1] mb-1.5">Size (<span id="lbl-font-size">36</span>px)</label>
              <input type="range" id="slider-font-size" min="16" max="80" value="36" class="w-full h-1.5 bg-[#ebebeb] dark:bg-[#222222] rounded-lg appearance-none cursor-pointer accent-[#0070f3] mt-2" />
            </div>
          </div>

          <!-- Colors & Stroke Row -->
          <div class="grid grid-cols-3 gap-3">
            <div>
              <label class="block font-mono-eyebrow text-[10px] text-[#4d4d4d] dark:text-[#a1a1a1] mb-1">Fill Color</label>
              <div class="flex items-center gap-2">
                <input type="color" id="color-text-fill" value="#ffffff" class="w-8 h-8 rounded border-0 cursor-pointer bg-transparent" />
                <span id="lbl-color-fill" class="text-xs font-mono text-[#8f8f8f]">#FFF</span>
              </div>
            </div>
            <div>
              <label class="block font-mono-eyebrow text-[10px] text-[#4d4d4d] dark:text-[#a1a1a1] mb-1">Stroke</label>
              <div class="flex items-center gap-2">
                <input type="color" id="color-text-stroke" value="#000000" class="w-8 h-8 rounded border-0 cursor-pointer bg-transparent" />
                <span id="lbl-color-stroke" class="text-xs font-mono text-[#8f8f8f]">#000</span>
              </div>
            </div>
            <div>
              <label class="block font-mono-eyebrow text-[10px] text-[#4d4d4d] dark:text-[#a1a1a1] mb-1">Stroke W</label>
              <input type="range" id="slider-stroke-width" min="0" max="10" value="3" class="w-full h-1.5 bg-[#ebebeb] dark:bg-[#222222] rounded-lg appearance-none cursor-pointer accent-[#0070f3] mt-2" />
            </div>
          </div>

          <!-- Caption Banner & Style Options -->
          <div class="space-y-2 pt-2 border-t border-[#ebebeb] dark:border-[#222222]">
            <label class="flex items-center justify-between cursor-pointer text-xs text-[#171717] dark:text-white p-2 rounded bg-[#fafafa] dark:bg-[#161616]">
              <span class="font-medium">Top Caption Banner (Twitter/Reddit Style)</span>
              <input type="checkbox" id="chk-caption-banner" class="rounded accent-[#0070f3] w-4 h-4" />
            </label>

            <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
              <div class="flex items-center gap-3">
                <label class="flex items-center gap-1.5 cursor-pointer text-xs text-[#171717] dark:text-white">
                  <input type="checkbox" id="chk-uppercase" checked class="rounded accent-[#0070f3]" />
                  <span>ALL CAPS</span>
                </label>
                <label class="flex items-center gap-1.5 cursor-pointer text-xs text-[#171717] dark:text-white">
                  <input type="checkbox" id="chk-text-shadow" checked class="rounded accent-[#0070f3]" />
                  <span>Shadow</span>
                </label>
              </div>
              <div class="flex items-center gap-2">
                <button id="btn-add-floating-text" class="px-2.5 py-1 rounded-[6px] bg-[#171717] dark:bg-white text-white dark:text-[#171717] text-xs font-medium hover:opacity-90 transition-all flex items-center gap-1">
                  <span>+ Add Text Box</span>
                </button>
                <button id="btn-remove-floating-text" class="px-2.5 py-1 rounded-[6px] bg-[#fafafa] dark:bg-[#181818] border border-[#ebebeb] dark:border-[#333333] text-[#eb5757] hover:bg-[#eb5757]/10 text-xs font-medium transition-all flex items-center gap-1" title="Remove current or last text box">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                  <span>Remove Text Box</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB CONTENT 2: CAPTION GENERATOR -->
        <div id="tab-ai" class="tab-panel hidden flex flex-col gap-4">
          <div class="p-3.5 rounded-xl bg-gradient-to-br from-[#7928ca]/10 via-[#0070f3]/10 to-[#ff0080]/10 border border-[#7928ca]/20">
            <div class="flex items-center gap-2 mb-1">
              <h4 class="text-sm font-bold text-[#171717] dark:text-white">Instant Meme Caption Engine</h4>
              <span class="ml-auto text-[10px] font-bold px-2 py-0.5 rounded bg-[#7928ca] text-white">PRO</span>
              <span id="lbl-ai-left" class="text-[10px] font-mono text-[#7928ca] dark:text-[#d8ccf1]">3 free left</span>
            </div>
            <p class="text-xs text-[#4d4d4d] dark:text-[#a1a1a1]">
              Pick a comedic vibe to auto-generate hilarious top & bottom captions for your meme.
            </p>
          </div>

          <div class="grid grid-cols-2 gap-2">
            <button data-ai-category="humorous" class="ai-gen-btn p-3 rounded-lg border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#161616] hover:border-[#7928ca] transition-all text-left flex flex-col gap-1 group">
              <span class="text-xs font-bold text-[#171717] dark:text-white flex items-center justify-between">
                <span>😂 Humorous</span>
                <span class="text-[10px] text-[#8f8f8f] group-hover:text-[#7928ca]">Generate →</span>
              </span>
              <span class="text-[11px] text-[#8f8f8f]">Classic tech & programmer jokes</span>
            </button>

            <button data-ai-category="relatable" class="ai-gen-btn p-3 rounded-lg border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#161616] hover:border-[#7928ca] transition-all text-left flex flex-col gap-1 group">
              <span class="text-xs font-bold text-[#171717] dark:text-white flex items-center justify-between">
                <span>🔥 Relatable</span>
                <span class="text-[10px] text-[#8f8f8f] group-hover:text-[#7928ca]">Generate →</span>
              </span>
              <span class="text-[11px] text-[#8f8f8f]">Everyday situations & life humor</span>
            </button>

            <button data-ai-category="tech" class="ai-gen-btn p-3 rounded-lg border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#161616] hover:border-[#7928ca] transition-all text-left flex flex-col gap-1 group">
              <span class="text-xs font-bold text-[#171717] dark:text-white flex items-center justify-between">
                <span>💻 Tech & Dev</span>
                <span class="text-[10px] text-[#8f8f8f] group-hover:text-[#7928ca]">Generate →</span>
              </span>
              <span class="text-[11px] text-[#8f8f8f]">CSS, JS, bugs & prod deploys</span>
            </button>

            <button data-ai-category="sarcastic" class="ai-gen-btn p-3 rounded-lg border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#161616] hover:border-[#7928ca] transition-all text-left flex flex-col gap-1 group">
              <span class="text-xs font-bold text-[#171717] dark:text-white flex items-center justify-between">
                <span>😏 Sarcastic</span>
                <span class="text-[10px] text-[#8f8f8f] group-hover:text-[#7928ca]">Generate →</span>
              </span>
