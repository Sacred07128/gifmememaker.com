---
---

<section class="relative overflow-hidden pt-12 pb-16 lg:pt-20 lg:pb-24 border-b border-[#ebebeb] dark:border-[#222222]">
  <!-- Vercel Geist Mesh Radial Background -->
  <div class="absolute inset-0 geist-mesh-gradient opacity-80 pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <!-- Screen-reader accessible H1 for SEO compliance -->
    <h1 class="sr-only">Free Meme Maker & GIF Generator Online - gifmememaker.com</h1>

    <!-- Subtitle -->
    <p class="text-lg sm:text-2xl text-[#4d4d4d] dark:text-[#a1a1a1] max-w-3xl mx-auto mb-12 font-medium leading-relaxed">
      The online meme maker with instant caption generator, 150+ static &amp; GIF templates and video meme maker — 100% free features, no signup, no downloads.
    </p>

    <!-- Enlarged Quick Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-5 max-w-2xl mx-auto mb-16">
      <!-- Primary Pill Button -->
      <a 
        href="#studio" 
        class="w-full sm:w-auto px-10 sm:px-12 py-5 sm:py-6 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] font-bold text-lg sm:text-xl hover:opacity-95 transition-all shadow-xl hover:shadow-2xl hover:scale-[1.02] flex items-center justify-center gap-3 group active:scale-98"
      >
        <span>Launch Meme Studio</span>
        <svg class="w-6 h-6 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>

      <!-- Secondary Pill Button -->
      <a 
        href="#templates" 
        class="w-full sm:w-auto px-8 sm:px-10 py-5 sm:py-6 rounded-full bg-white dark:bg-[#111111] text-[#171717] dark:text-white border-2 border-[#ebebeb] dark:border-[#333333] font-bold text-lg sm:text-xl hover:bg-[#fafafa] dark:hover:bg-[#1a1a1a] transition-all shadow-lg hover:shadow-xl hover:scale-[1.02] flex items-center justify-center gap-3 active:scale-98"
      >
        <svg class="w-6 h-6 text-[#8f8f8f]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
        </svg>
        <span>Browse 150+ Templates</span>
      </a>
    </div>

    <!-- Feature Highlights Pills (Geist Specs) -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-3xl mx-auto pt-6 border-t border-[#ebebeb] dark:border-[#222222]/80">
      <div class="flex items-center justify-center gap-2 py-2 px-3 rounded-lg bg-white/60 dark:bg-[#111111]/60 border border-[#ebebeb] dark:border-[#222222]">
        <svg class="w-4 h-4 text-[#0070f3]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
        <span class="text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1a1]">⚡ Instant Captions</span>
      </div>
      <div class="flex items-center justify-center gap-2 py-2 px-3 rounded-lg bg-white/60 dark:bg-[#111111]/60 border border-[#ebebeb] dark:border-[#222222]">
        <svg class="w-4 h-4 text-[#7928ca]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <span class="text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1a1]">⚡ Free & Pro Features</span>
      </div>
      <div class="flex items-center justify-center gap-2 py-2 px-3 rounded-lg bg-white/60 dark:bg-[#111111]/60 border border-[#ebebeb] dark:border-[#222222]">
        <svg class="w-4 h-4 text-[#ff0080]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15.536a5 5 0 001.414 1.414m2.828-9.9a9 9 0 010 12.728"></path>
        </svg>
        <span class="text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1a1]">🎞️ Animated GIF Maker</span>
      </div>
      <div class="flex items-center justify-center gap-2 py-2 px-3 rounded-lg bg-white/60 dark:bg-[#111111]/60 border border-[#ebebeb] dark:border-[#222222]">
        <svg class="w-4 h-4 text-[#50e3c2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
        </svg>
        <span class="text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1a1]">🔒 100% Private Client Engine</span>
      </div>
    </div>
  </div>
</section>
