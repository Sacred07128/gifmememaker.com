---
import Logo from './Logo.astro';
import LanguageSelector from './LanguageSelector.astro';
---

<header class="sticky top-0 z-50 w-full border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa]/80 dark:bg-[#0a0a0a]/80 backdrop-blur-md transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <Logo class="w-9 h-9 shrink-0 rounded-xl shadow-sm group-hover:scale-105 transition-transform duration-200" />
      <span class="font-bold text-base tracking-tight text-[#171717] dark:text-white flex items-center gap-1.5">
        gifmememaker.com
      </span>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-1">
      <a href="/#studio" class="px-3.5 py-1.5 rounded-full text-sm font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#ebebeb]/50 dark:hover:bg-[#1a1a1a] transition-all">
        Studio Generator
      </a>
      <a href="/#templates" class="px-3.5 py-1.5 rounded-full text-sm font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#ebebeb]/50 dark:hover:bg-[#1a1a1a] transition-all">
        Template Vault
      </a>
      <a href="/#comparison" class="px-3.5 py-1.5 rounded-full text-sm font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#ebebeb]/50 dark:hover:bg-[#1a1a1a] transition-all">
        Free vs Premium Tiers
      </a>
      <a href="/#faq" class="px-3.5 py-1.5 rounded-full text-sm font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white hover:bg-[#ebebeb]/50 dark:hover:bg-[#1a1a1a] transition-all">
        FAQ
      </a>
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3">
      <!-- Language Selector -->
      <LanguageSelector />

      <!-- Dark Mode Toggle Button (6px square app control per DESIGN.md) -->
      <button 
        id="theme-toggle" 
        aria-label="Toggle theme"
        class="w-9 h-9 rounded-[6px] border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#111111] text-[#171717] dark:text-white flex items-center justify-center hover:bg-[#fafafa] dark:hover:bg-[#1a1a1a] transition-colors"
      >
        <svg id="theme-sun" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <svg id="theme-moon" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>

      <!-- Primary Marketing Pill CTA per DESIGN.md -->
      <a 
        href="/#studio" 
        class="px-4 py-2 rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] text-xs sm:text-sm font-medium hover:opacity-90 transition-all flex items-center gap-1.5 shadow-sm active:scale-95"
      >
        <span>Open Studio</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  const savedTheme = localStorage.getItem('theme');
  if (savedTheme === 'light') {
    document.documentElement.classList.remove('dark');
  } else if (savedTheme === 'dark') {
    document.documentElement.classList.add('dark');
  }
</script>
